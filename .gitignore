# Credenziali e Segreti
.env
*.session
*.key
*.cert
secrets.py

# Dati e Risultati (Dataset pesanti o privati)
# NB: si usa data/* (non data/) perche' git non puo' re-includere file
# dentro una directory interamente esclusa.
data/*
!data/raw/
data/raw/*
!data/results/
data/results/*
!data/results/figures/
*.csv
*.txt
*.json
*.xlsx
*.parquet

# --- Eccezioni: artefatti della run canonica (riproducibilita' del paper) ---
# Dataset "dehydrated": solo metadati Guardian (id/url/titolo/data), niente
# full-text (termini d'uso delle testate). Il testo integrale si rigenera con
# Build_Dataset/Papers/05_guardian.py o e' disponibile su richiesta.
!data/raw/Guardian_articles_metadata.csv
!data/README_DATA.md
# Tabelle LaTeX e output del topic modeling
!data/results/*.tex
!data/results/lda_topics_en.txt
!data/results/lda_topics_it.txt
!data/results/optimal_k_en.json
!data/results/optimal_k_it.json
!data/results/coherence_values_en.csv
!data/results/coherence_values_it.csv
# Riproducibilita' Tabella 2 (frammenti narrativi con ID tracciabili)
!data/results/fig8_selected_ids.json
!data/results/fig8_candidates.csv
# Campione di validazione sentiment (annotazione manuale cieca)
!data/results/validation_annotation_TODO.csv
!data/results/validation_sampling_cells.csv
# Esperimento item-level k-sweep (richiesta RP: pseudo-replicazione)
!data/results/item_ksweep_similarity.csv
!data/results/item_coherence_values.csv
!data/results/item_sentiment_by_source.csv
!data/results/items_en_meta.csv
!data/results/item_topics_k*.txt
!data/results/document_topics_items_k*.csv
# Figure pubblicate (PNG + PDF + tex)
!data/results/figures/*

